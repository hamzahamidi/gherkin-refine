{
  "name": "gherkin-refine",
  "version": "1.3.1",
  "description": "Gherkin and Cucumber linter with gherkin-lint compatibility: all 31 gherkin-lint rules, safe autofix, plugins, and SARIF output.",
  "type": "module",
  "bin": {
    "gherkin-refine": "./dist/cli.js",
    "gherkinlint": "./dist/cli.js",
    "gherkin-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "!docs/.vitepress",
    "schemas"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "npm run build && vitest run --coverage",
    "smoke": "node scripts/smoke-package.mjs",
    "bench": "node --expose-gc scripts/benchmark.mjs",
    "check:pack": "npm pack --dry-run",
    "validate": "npm run typecheck && npm run lint && npm run build && npm run docs:check && npm test && npm run smoke && npm run check:pack",
    "prepack": "npm run build",
    "compatibility": "npm run build && node scripts/compatibility.mjs",
    "compatibility:full": "npm run build && node scripts/compatibility.mjs --full",
    "compatibility:published": "node scripts/compatibility.mjs --full --published",
    "docs:rules": "npm run build && node scripts/generate-rule-docs.mjs",
    "docs:dev": "npm run docs:rules && node scripts/generate-llms.mjs && vitepress dev docs",
    "docs:build": "npm run docs:rules && node scripts/generate-llms.mjs && vitepress build docs",
    "docs:check": "node scripts/generate-rule-docs.mjs --check"
  },
  "keywords": [
    "gherkin",
    "gherkin-lint",
    "gherkin-linter",
    "gherkinlint",
    "gherkin-validator",
    "cucumber",
    "cucumber-js",
    "cucumber-lint",
    "bdd",
    "feature-files",
    "linter",
    "autofix",
    "typescript",
    "nodejs",
    "sarif",
    "ai-agents"
  ],
  "author": {
    "name": "Hamza Hamidi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamzahamidi/gherkin-refine.git"
  },
  "homepage": "https://hamidihamza.com/gherkin-refine/",
  "funding": "https://github.com/sponsors/hamzahamidi",
  "bugs": {
    "url": "https://github.com/hamzahamidi/gherkin-refine/issues"
  },
  "dependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "commander": "^14.0.0",
    "glob": "^13.0.6",
    "minimatch": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.12.0",
    "gherkin-lint": "4.2.4",
    "globals": "^17.13.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.56.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.0"
  }
}
